# Copy to .env.local for local development. Never commit real values.

# Public URL of the site, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact form (server-side only; never prefix these with NEXT_PUBLIC_) ---
# Without these three, the form answers "unavailable" and nothing is sent.
# Resend API key with "Sending access" only, restricted to the site's domain.
RESEND_API_KEY=
# Inbox that receives the messages.
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend.
CONTACT_FROM_EMAIL="Formulaire siavashizadi.com <formulaire@siavashizadi.com>"
# Tests only: point at the local mock provider instead of Resend.
# CONTACT_EMAIL_API_URL=http://127.0.0.1:4010/emails
